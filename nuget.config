<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ignora feeds configurados na máquina e usa apenas o nuget.org, para o restore ser reproduzível. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
