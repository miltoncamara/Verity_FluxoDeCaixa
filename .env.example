# Valores opcionais. Sem um arquivo .env o docker compose usa os padrões "local-dev",
# que servem apenas para containers descartáveis rodando na sua máquina.
# Em produção esses valores viriam de um cofre de segredos (Azure Key Vault).
POSTGRES_PASSWORD=local-dev
RABBITMQ_PASSWORD=local-dev

# Chaves dos clientes da API, enviadas no header X-Api-Key (exceto em /health).
# admin tem todas as permissões, pdv só registra lançamentos e bi só lê.
# As APIs guardam só o hash SHA-256 de cada chave. Para gerar o hash de uma chave nova:
#   echo -n "sua-chave" | sha256sum
# Os valores abaixo são os hashes de local-dev-key, local-pdv-key e local-bi-key.
API_KEY_SHA256=ed5a18fb8f807f996d649e379d3f35f39c543a91bdbf88c492f2ebd10d4df86c
API_KEY_PDV_SHA256=cf3e7f2e03dd372dda448cfd2aaaad6c001379f05f3b08e083836a9246a98c7f
API_KEY_BI_SHA256=76bfcb761ec5bc9649a0de6451834fdf4ba35b72c829f115b389227f702b58ec

# Chave do admin em texto, usada pelos scripts de carga, capacidade e caos.
# Precisa corresponder ao API_KEY_SHA256.
API_KEY=local-dev-key
