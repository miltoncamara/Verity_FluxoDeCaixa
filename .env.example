# Valores opcionais. Sem um arquivo .env o docker compose usa os padrões "local-dev",
# que servem apenas para containers descartáveis rodando na sua máquina.
# Em produção esses valores viriam de um cofre de segredos (Azure Key Vault).
POSTGRES_PASSWORD=local-dev
RABBITMQ_PASSWORD=local-dev

# Chaves dos clientes da API, enviadas no header X-Api-Key (exceto em /health).
# admin tem todas as permissões, pdv só registra lançamentos e bi só lê.
API_KEY=local-dev-key
API_KEY_PDV=local-pdv-key
API_KEY_BI=local-bi-key
